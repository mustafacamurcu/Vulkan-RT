#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba8) uniform image2D image;

layout(push_constant) uniform constants
{
    mat4 invView;
    mat4 invProj;
} PC;

layout(location = 0) rayPayloadEXT vec3 hitValue;

void main()
{
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 inUV = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    // Unproject the pixel through the same camera the raster path used
    vec4 origin = PC.invView * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target = PC.invProj * vec4(d.x, d.y, 1.0, 1.0);
    vec4 direction = PC.invView * vec4(normalize(target.xyz / target.w), 0.0);

    uint rayFlags = gl_RayFlagsOpaqueEXT;
    float tMin = 0.001;
    float tMax = 10000.0;

    hitValue = vec3(0.0);

    traceRayEXT(topLevelAS, rayFlags, 0xFF, 0, 0, 0, origin.xyz, tMin, direction.xyz, tMax, 0);

    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(hitValue, 1.0));
}
