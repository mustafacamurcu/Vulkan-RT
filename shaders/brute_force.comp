#version 460

// Grid ray tracer: cubes are stored in a uniform 3D grid (every cell lists the
// cubes overlapping it). Each ray walks the grid cell by cell along its path
// (3D-DDA), nearest cell first, testing only the cubes in those cells, and stops
// as soon as its closest hit lies inside the current cell.
layout(local_size_x = 8, local_size_y = 8) in;

// Inverse world transform of each cube (64 bytes): turns a world-space ray into
// the cube's local space, where the cube is [-0.5, 0.5]^3. Sorted by grid cell
// (a cube that overlaps several cells appears once per cell).
struct Cube {
    mat4 invTransform;
};

layout(std430, binding = 0) readonly buffer CubeBuffer {
    Cube cubes[];
};

layout(binding = 1, rgba8) uniform writeonly image2D image;

// Bounding sphere of each cube: xyz = center, w = radius (16 bytes). Sorted by grid cell.
layout(std430, binding = 2) readonly buffer SphereBuffer {
    vec4 spheres[];
};

// The cubes of cell c are cubes[cellStart[c]] .. cubes[cellStart[c + 1] - 1]
layout(std430, binding = 3) readonly buffer CellBuffer {
    uint cellStart[];
};

// Original index of each (sorted) cube, so every cube keeps its color
layout(std430, binding = 4) readonly buffer CubeIdBuffer {
    uint cubeIds[];
};

layout(push_constant) uniform constants
{
    mat4 invViewProj;
    vec4 cameraPos;
    uvec4 params;   // x = cube count, yz = pixel offset of this tile, w = grid resolution
    vec4 gridMin;   // xyz = grid's min corner, w = cell size
} PC;

// Same per-cube color as the hardware ray tracing path
vec3 instanceColor(uint id)
{
    float hue = fract(float(id) * 0.61803398875);
    vec3 rgb = clamp(abs(mod(hue * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
    return mix(vec3(1.0), rgb, 0.8);
}

float closestT;
int closestCube;

// Sphere test, then exact box test, for every cube listed in one cell
void testCell(uint cell, vec3 origin, vec3 direction)
{
    uint end = cellStart[cell + 1];
    for (uint i = cellStart[cell]; i < end; i++) {
        // Cheap rejection: does the ray's line pass within the bounding sphere?
        vec4 sphere = spheres[i];
        vec3 toCenter = sphere.xyz - origin;
        float along = dot(toCenter, direction);
        float distSq = dot(toCenter, toCenter) - along * along;
        if (distSq > sphere.w * sphere.w) {
            continue;
        }

        mat4 invTransform = cubes[i].invTransform;

        // Ray in cube space. The transform is linear, so t is the same in both spaces.
        vec3 localOrigin = (invTransform * vec4(origin, 1.0)).xyz;
        vec3 localDir = (invTransform * vec4(direction, 0.0)).xyz;

        // Slab test against the unit cube
        vec3 t1 = (vec3(-0.5) - localOrigin) / localDir;
        vec3 t2 = (vec3(0.5) - localOrigin) / localDir;
        vec3 tNear = min(t1, t2);
        vec3 tFar = max(t1, t2);
        float tEnter = max(max(tNear.x, tNear.y), tNear.z);
        float tExit = min(min(tFar.x, tFar.y), tFar.z);

        if (tEnter <= tExit && tExit > 0.0 && tEnter < closestT) {
            closestT = max(tEnter, 0.0);
            closestCube = int(i);
        }
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy + PC.params.yz);
    ivec2 size = imageSize(image);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    // Unproject the pixel onto the far plane to get the ray direction
    vec2 d = (vec2(pixel) + vec2(0.5)) / vec2(size) * 2.0 - 1.0;
    vec4 farPoint = PC.invViewProj * vec4(d, 1.0, 1.0);
    vec3 origin = PC.cameraPos.xyz;
    vec3 direction = normalize(farPoint.xyz / farPoint.w - origin);
    vec3 invDirection = 1.0 / direction;

    closestT = 1e30;
    closestCube = -1;

    int resolution = int(PC.params.w);
    float cellSize = PC.gridMin.w;
    vec3 gridMin = PC.gridMin.xyz;
    vec3 gridMax = gridMin + cellSize * float(resolution);

    // Where does the ray enter and leave the whole grid? (it may start outside)
    vec3 g1 = (gridMin - origin) * invDirection;
    vec3 g2 = (gridMax - origin) * invDirection;
    vec3 gNear = min(g1, g2);
    vec3 gFar = max(g1, g2);
    float gridEnter = max(max(max(gNear.x, gNear.y), gNear.z), 0.0);
    float gridExit = min(min(gFar.x, gFar.y), gFar.z);

    if (gridEnter <= gridExit) {
        // ---- 3D-DDA setup ----
        // The cell the ray starts in
        vec3 startPos = origin + direction * gridEnter;
        ivec3 cell = clamp(ivec3(floor((startPos - gridMin) / cellSize)), ivec3(0), ivec3(resolution - 1));

        // Which way to step on each axis (+1 or -1; 0 if the ray is parallel to that axis)
        ivec3 stepDir = ivec3(sign(direction));
        // t needed to cross one whole cell along each axis
        vec3 tDelta = abs(cellSize * invDirection);
        // t at which the ray reaches the next cell wall on each axis
        vec3 nextWall = gridMin + (vec3(cell) + vec3(greaterThan(stepDir, ivec3(0)))) * cellSize;
        vec3 tMax = (nextWall - origin) * invDirection;
        // A ray parallel to an axis never crosses that axis' walls
        tMax = mix(tMax, vec3(1e30), equal(stepDir, ivec3(0)));

        // ---- Walk the cells along the ray, nearest first ----
        while (true) {
            uint cellIndex = uint(cell.x + resolution * (cell.y + resolution * cell.z));
            testCell(cellIndex, origin, direction);

            // Early exit: a hit inside this cell beats anything in later cells
            float cellExit = min(min(tMax.x, tMax.y), tMax.z);
            if (closestT <= cellExit) {
                break;
            }

            // Step through whichever wall the ray reaches first
            if (tMax.x < tMax.y && tMax.x < tMax.z) {
                cell.x += stepDir.x;
                tMax.x += tDelta.x;
            } else if (tMax.y < tMax.z) {
                cell.y += stepDir.y;
                tMax.y += tDelta.y;
            } else {
                cell.z += stepDir.z;
                tMax.z += tDelta.z;
            }

            // Left the grid: nothing more to hit
            if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, ivec3(resolution)))) {
                break;
            }
        }
    }

    vec3 color = closestCube >= 0 ? instanceColor(cubeIds[closestCube]) : vec3(0.0);
    imageStore(image, pixel, vec4(color, 1.0));
}
